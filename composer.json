{
    "name": "swarakaka/bridge-laravel",
    "description": "Bridge: a server-driven application protocol for Laravel with Page, JSON and SSE modes from one controller",
    "keywords": [
        "laravel",
        "bridge",
        "spa",
        "sse",
        "api",
        "content-negotiation"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/swarakaka/Bridge",
    "support": {
        "issues": "https://github.com/swarakaka/Bridge/issues",
        "source": "https://github.com/swarakaka/Bridge"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "opis/json-schema": "^2.3",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Bridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bridge\\BridgeServiceProvider"
            ],
            "aliases": {
                "Bridge": "Bridge\\Facades\\Bridge"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
